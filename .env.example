DATABASE_URL="file:./demo.db"
DEMO_MODE="true"
APP_URL="http://127.0.0.1:3000"
# Set COOKIE_SECURE=true behind HTTPS in a production environment.
COOKIE_SECURE="false"
# Hosted sandbox only (do not enable these flags for live commerce):
# APP_ENV="demo"
# ALLOW_HOSTED_DEMO_SEED="true"
# DEMO_ADMIN_PASSWORD=<separate randomly generated secret, at least 20 characters>
# Render supplies RENDER_EXTERNAL_URL. Do not copy local APP_URL into Render.
# Netlify uses DATABASE_PROVIDER=postgresql and its automatic NETLIFY_DB_URL.
# Keep hosted credentials in Netlify; .env.netlify is ignored by Git.
